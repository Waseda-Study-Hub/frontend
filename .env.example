# FastAPI origin. Do not add a trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public Firebase Web SDK identifiers. These are not Firebase Admin secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-app-id

# Keep this exact-domain list aligned with backend ALLOWED_EMAIL_DOMAINS.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=fuji.waseda.jp,suou.waseda.jp

# Never place Firebase Admin credentials, private keys, or service-account JSON
# in this app or any NEXT_PUBLIC_* variable.
